# Browser-safe Supabase values. These are intentionally public and are bundled
# into browser code by Next.js because they use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Browser-safe site URL used for metadata and auth redirect construction.
# Local: http://localhost:3000
# Vercel production: https://psynova-phi.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Do not expose this in client components or browser code.
# This project does not need the service role key for the current UI flows.
SUPABASE_SERVICE_ROLE_KEY=

# Local Supabase CLI only. Do not add this to browser code or commit real tokens.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=

# Reserved for later phases. Leave empty until those integrations are built.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
